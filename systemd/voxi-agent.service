[Unit]
Description=Voxi Voice Input Agent
Documentation=https://codeberg.org/ubunatic/voxi
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=voxtype.service voxtype-streaming.service voxi-eager.service harnez-voice-eager.service

[Service]
Type=simple
ExecStart=%h/.local/bin/voxi agent --daemon
Restart=on-failure
RestartSec=3

Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
