[Unit]
Description=Voxi Continuous Eager Sentence Streaming Dictation
Documentation=https://codeberg.org/ubunatic/voxi
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voxi eager --daemon
Restart=on-failure
RestartSec=3

Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
