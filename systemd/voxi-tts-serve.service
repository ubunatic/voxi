[Unit]
Description=Voxi tts-serve local Chatterbox TTS server
Documentation=https://codeberg.org/ubunatic/voxi
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.cache/voxi/tts-serve
Environment=CHATTERBOX_HOST=127.0.0.1
Environment=CHATTERBOX_PORT=@TTS_SERVE_PORT@
Environment=CHATTERBOX_DEVICE=cpu
ExecStart=%h/.cache/voxi/tts-serve/.venv/bin/python impl/server_chatterbox.py
Restart=on-failure
RestartSec=3
# Measured peak RSS while loading the model and serving one request was
# ~7.3 GiB (issue 159 M2); 8G left too little margin, so this leaves headroom
# instead of Restart=on-failure looping on an OOM kill.
MemoryMax=12G

[Install]
WantedBy=graphical-session.target
