# CRITICAL SAFETY RULE:
# Container tests running from this image must NEVER mount host /dev/uinput or
# /dev/input devices when running on workstations with active graphical desktop
# sessions. Linux uinput and evdev are kernel-global and not namespaced, so
# injecting keystrokes into a mapped uinput device leaks synthetic typing
# directly into focused host desktop windows.

FROM golang:1.26-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    tar \
    git \
    sudo \
    procps \
    libevdev2 \
    gcc \
    libc6-dev \
    pkg-config \
    libxkbcommon-dev \
    systemd \
    systemd-sysv \
    dbus \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -u 1000 testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/testuser && \
    chmod 0440 /etc/sudoers.d/testuser

USER testuser
WORKDIR /home/testuser
ENV HOME=/home/testuser
ENV USER=testuser
ENV PATH="/home/testuser/.local/bin:/home/testuser/go/bin:${PATH}"

CMD ["/bin/bash"]
