{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Voxi TTS Playback Tuning",
  "description": "Playback tuning for monitor-gated text to speech.",
  "type": "object",
  "required": ["backend", "piper", "voxcpm", "playback", "llm"],
  "properties": {
    "backend": {
      "type": "object",
      "required": ["default_backend"],
      "properties": {
        "default_backend": { "type": "string", "enum": ["auto", "piper", "festival", "espeak-ng", "voxcpm"] }
      },
      "additionalProperties": false
    },
    "piper": {
      "type": "object",
      "required": ["model", "config"],
      "properties": {
        "model": { "type": "string" },
        "config": { "type": "string" }
      },
      "additionalProperties": false
    },
    "voxcpm": {
      "type": "object",
      "required": ["runtime_version", "source_commit", "runtime_assets", "binary", "model", "model_revision", "model_url", "model_sha256", "backend", "family", "threads", "seed", "num_inference_steps", "guidance_scale", "default_preset", "max_text_chars", "presets"],
      "properties": {
        "runtime_version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "runtime_assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "sha256"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "binary": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 1 },
        "model_url": { "type": "string", "format": "uri" },
        "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "backend": { "type": "string", "enum": ["vulkan"] },
        "family": { "type": "string", "minLength": 1 },
        "threads": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "num_inference_steps": { "type": "integer", "minimum": 1 },
        "guidance_scale": { "type": "number", "exclusiveMinimum": 0 },
        "default_preset": { "type": "string", "enum": ["full", "short"] },
        "max_text_chars": { "type": "integer", "minimum": 1 },
        "presets": {
          "type": "object",
          "required": ["full", "short"],
          "properties": {
            "full": { "$ref": "#/definitions/voicePreset" },
            "short": { "$ref": "#/definitions/voicePreset" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "playback": {
      "type": "object",
      "required": ["trailing_silence_trim_ms", "trailing_silence_threshold_db"],
      "properties": {
        "trailing_silence_trim_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Maximum trailing quiet audio to remove from each synthesized chunk, in milliseconds."
        },
        "trailing_silence_threshold_db": {
          "type": "number",
          "minimum": -80,
          "maximum": -10,
          "description": "PCM amplitude threshold in dBFS; samples below this level count as trailing silence."
        }
      },
      "additionalProperties": false
    },
    "llm": {
    "type": "object",
    "required": ["default_host", "max_tokens"],
    "properties": {
      "default_host": { "type": "string", "minLength": 1 },
      "max_tokens": { "type": "integer", "minimum": 1, "maximum": 32768 }
    },
    "additionalProperties": false
    }
  },
  "definitions": {
    "voicePreset": {
      "type": "object",
      "required": ["reference_wav", "reference_text", "session_options"],
      "properties": {
        "reference_wav": { "type": "string", "minLength": 1 },
        "reference_text": { "type": "string", "minLength": 1 },
        "reference_start_sample": { "type": "integer", "minimum": 0 },
        "reference_end_sample": { "type": "integer", "minimum": 1 },
        "session_options": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
